# Copy to .env and fill in to enable Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alpaca (Phase 5). Paper keys: alpaca.markets -> Paper Trading -> API Keys.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
# Live keys: only if you deliberately set broker.mode: live. Leave empty otherwise.
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=

# AI market study (ai_study.enabled in settings.yaml). Key from console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
